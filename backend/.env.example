# ---- Gemini (Google AI Studio) ----
LLM_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=your_google_api_key_here

# ---- OpenAI (via LiteLLM) ----
# LLM_MODEL=litellm:openai/gpt-5.6-terra
# OPENAI_API_KEY=your_openai_api_key_here

# ---- Anthropic (via LiteLLM) ----
# LLM_MODEL=litellm:anthropic/claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---- Amazon Bedrock (via LiteLLM) ----
# LLM_MODEL=litellm:bedrock/global.anthropic.claude-sonnet-4-6
# AWS_BEARER_TOKEN_BEDROCK=xxxxxxxxx

# ---- Server settings ----
HOST=0.0.0.0
PORT=8000
# Enables uvicorn autoreload. Only affects `python -m backend.main`; the
# documented `uv run uvicorn main:app --reload` command and the Dockerfile's
# startup path are unaffected either way. Defaults to false.
# RELOAD=true

# ---- CORS ----
# Comma-separated list of allowed origins for /chat and /sessions.
# Add each frontend origin that should be permitted to call the API.
# '*' is rejected at startup: allow_credentials=True is always enabled, and
# the CORS spec forbids pairing a wildcard origin with credentialed requests.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Database URL for REST API data and ADK session storage (both share the same
# database). SQLite is the zero-config default; point this at PostgreSQL to
# switch backends. The async driver suffix (aiosqlite / asyncpg) is added
# automatically, so the plain scheme is enough.
DB_URL=sqlite:///a2flow.db
# DB_URL=postgresql://user:password@localhost:5432/a2flow

# ---- Root user ----
# Password for the initial 'root' user (platform-wide, holds super_admin)
# auto-created on first startup. Only used while the database has no real
# users yet.
# If unset, a random password is generated and logged once (at WARNING
# level) to the backend's startup output - see `docker compose logs backend`.
# It cannot be recovered afterwards, so set this explicitly for anything
# beyond local experimentation.
# ROOT_PASSWORD=change-me-now-123

# ---- Default tenant admin user ----
# Password for the 'admin' user auto-created inside the seeded "Default"
# tenant on first startup. Only used while no user named 'admin' exists yet.
# Same generate-and-log-once fallback as ROOT_PASSWORD when unset.
# ADMIN_PASSWORD=change-me-now-123

# ---- Demo data ----
# Set to true to register a ready-made example of the "launch an EC2 instance
# with a manager's approval" workflow in the seeded "Default" tenant on
# startup: one AWS credentials secret holding both keys, an AWS MCP server
# (stdio, reached through the mcp-proxy-for-aws bridge launched with uvx), the
# sample aws-ec2-launch agent skill, and demo approver / requester / developer
# user accounts. Defaults to false.
# Setting it back to false (or removing it) removes those records again on the
# next startup, so this flag is the on/off switch in both directions.
# DEMO_DATA=true

# Shared password for the demo users. Same generate-and-log-once fallback as
# ROOT_PASSWORD when unset. Only used while a demo user is missing.
# DEMO_PASSWORD=change-me-now-123

# AWS credentials stored as the two entries of the demo secret. Leave unset to
# store a "REPLACE_ME" placeholder instead and fill the real values in from the
# admin UI; set them here to have the demo reach AWS straight after startup.
# They need permission to call the managed AWS MCP endpoint (the "aws-mcp"
# service) on top of whatever the tools themselves go on to do.
# NOTE: the demo MCP server is not restricted to read-only operations - it can
# create, modify, and delete real resources with these credentials.
# DEMO_AWS_ACCESS_KEY_ID=
# DEMO_AWS_SECRET_ACCESS_KEY=

# Region the demo MCP server's tools act on, passed to it as
# "--metadata AWS_REGION=...". This is separate from the region its requests
# are SigV4-signed for, which is fixed to the endpoint's own (us-east-1).
# Defaults to us-east-1.
# DEMO_AWS_REGION=us-east-1

# ---- Application base URL ----
# Base URL at which users reach this deployment in a browser (e.g.
# https://a2flow.example.com, or http://localhost:3000 for local
# development), stored in the system_settings table (the same record the
# admin UI's System Settings page edits) and used to build the deep links
# embedded in outgoing notification email. Same re-applied-on-every-startup
# semantics as the SMTP_* variables below: leaving it unset preserves
# whatever is already stored, including anything configured by hand in the
# admin UI. A malformed value (not starting with http:// or https://) is
# logged as a warning and skipped -- the app still starts, and the stored
# value is left as-is.
# APP_BASE_URL=http://localhost:3000

# ---- SMTP (outbound notification email) ----
# Configures the platform-wide SMTP relay used to deliver notification email,
# stored in the system_settings table (the same record the admin UI's System
# Settings page edits). Unlike ROOT_PASSWORD/ADMIN_PASSWORD (read once, at
# first-row creation), these variables are re-applied on *every* startup: only
# the fields you actually set here are written, so leaving a variable unset
# preserves whatever is already stored (including anything configured by hand
# in the admin UI). A malformed value (bad port, invalid email, or
# SMTP_ENABLED=true with no host) is logged as a warning and skipped entirely
# -- the app still starts, and the stored configuration is left as-is.
#
# SMTP_ENABLED must be explicitly true to switch email delivery on; it is
# never inferred from the other variables being present. The others may still
# be set (and will be applied) while this is unset/false, so you can stage a
# relay's config on one deploy and flip delivery on with a later one.
# SMTP_ENABLED=true

# Relay hostname or IP (e.g. smtp.example.com, or a bare internal/localhost
# name -- this is handed straight to smtplib, not fetched, so private/internal
# hosts are fine here unlike other URL-shaped settings in this file).
# SMTP_HOST=smtp.example.com

# Submission port. Defaults to 587 (STARTTLS) when the row itself has never
# been configured; unset here leaves whatever is already stored.
# SMTP_PORT=587

# How the connection is secured: none | starttls | ssl. Defaults to starttls.
# SMTP_SECURITY=starttls

# Relay username, if the relay requires authentication. A username with no
# password (here or already stored) fails validation once SMTP_ENABLED=true.
# SMTP_USERNAME=

# Relay password. Only ever written to the database as Fernet ciphertext
# (see SECRET_ENCRYPTION_KEY / SECRET_KEY_FILE below) -- never logged, and
# never returned by any API response.
# SMTP_PASSWORD=

# "From" address on outgoing notification email. Required once
# SMTP_ENABLED=true.
# SMTP_FROM_EMAIL=notifications@example.com

# "From" display name on outgoing notification email (optional).
# SMTP_FROM_NAME=A2Flow

# ---- Outgoing email queue ----
# Notification email is not sent while a workflow operation is in flight. The
# notification and a row in `outbound_emails` are written in one transaction,
# and a worker drains that queue: paced against the relay, retried with
# exponential backoff, and kept as a dead letter (status=failed, with the last
# error on the row) once the attempts run out. Nothing here needs setting for a
# normal deployment -- these are the knobs for a relay with unusual limits.
#
# Whether the API process also runs the drain worker. Defaults to true, so
# `uvicorn main:app` on its own delivers mail. compose.yml sets this false on
# the API because it runs the dedicated `worker` service instead. Leaving both
# on is safe -- the `email-queue` advisory lock elects exactly one sender across
# the deployment -- just pointless.
# EMAIL_WORKER_IN_PROCESS=true

# Sustained messages per second handed to the relay, and how many may go out
# back-to-back after an idle period before that rate applies. Lower these to sit
# under a stricter relay limit.
# EMAIL_SEND_RATE_PER_SECOND=5.0
# EMAIL_SEND_BURST=10

# How many messages one drain pass claims, and how long the worker sleeps when
# the queue is empty. The poll interval is the floor on delivery latency for a
# notification produced while the worker is asleep.
# EMAIL_QUEUE_BATCH_SIZE=20
# EMAIL_QUEUE_POLL_INTERVAL_SECONDS=5.0

# Delivery attempts before a message becomes a dead letter. The backoff runs
# 15s, 30s, 1m, 2m ... capped at an hour, so the default of 9 rides out roughly
# an hour of relay downtime; raise it to tolerate a longer outage. A failure the
# relay reports as permanent (an unknown recipient, say) is written off on the
# first attempt regardless.
# EMAIL_MAX_ATTEMPTS=9

# How long delivered messages are kept before the worker purges them. They are
# a record of what went out, not queue state. Dead letters are never purged.
# EMAIL_SENT_RETENTION_DAYS=30

# ---- Authentication ----
# Sliding idle timeout (seconds) for a login session. Each authenticated request
# refreshes the window; a session left idle longer than this is rejected.
# Defaults to 28800 (8 hours).
# SESSION_IDLE_TIMEOUT_SECONDS=28800
# Set to true to mark the session/CSRF cookies as Secure (HTTPS only).
# Leave false for local HTTP development. Defaults to false.
# SESSION_COOKIE_SECURE=false

# ---- Secret management ----
# Key used to Fernet-encrypt local secrets stored in the database.
# Resolution precedence:
#   1. SECRET_ENCRYPTION_KEY (must be a valid Fernet key; generate one with
#      `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
#   2. The key file at SECRET_KEY_FILE (defaults to .secret_key next to the
#      SQLite database file, or the working directory for other databases)
#   3. A key is generated, saved to that file, and a WARNING is logged.
# Back the key up: losing it makes every stored local secret undecryptable.
# SECRET_ENCRYPTION_KEY=
# SECRET_KEY_FILE=.secret_key

# ---- HashiCorp Vault (optional, for vault-type secrets) ----
# Single global connection; only the KV v2 engine is supported.
# AppRole credentials take precedence over the static token when both are set.
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=hvs.xxxxxxxx
# VAULT_ROLE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VAULT_SECRET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VAULT_APPROLE_MOUNT=approle

# ---- Agent skill store ----
# Root of the store Agent Skill repositories are shallow-cloned into, laid out
# as <skill_id>/<commit_sha>/. This is durable state, not a cache: a workflow
# session pins the revision it started with, so wiping it leaves existing
# sessions unable to load their skill until an admin pulls it again. Running
# more than one backend replica requires all of them to share this directory.
# Defaults to backend/.skills (relative to the working dir).
# SKILLS_DIR=.skills

# How long an unreferenced skill revision directory is kept before a pull may
# prune it. Defaults to 3600 (1 hour).
# SKILLS_PRUNE_GRACE_SECONDS=3600

# Per-request (connect/read) timeout, in seconds, for a skill clone's HTTP
# requests. Bounds how long a slow or hanging remote can stall a clone, which
# otherwise holds the skill's sync advisory lock indefinitely. Defaults to 120.
# SKILLS_CLONE_TIMEOUT_SECONDS=120

# ---- MCP approval certificates ----
# A task an approval covers -- the task the request names, plus every task
# after it up to the next approval -- cannot call its bound MCP tools until the
# approver grants it. Each covered task is then issued a short-lived X.509
# certificate when it starts, and the MCP proxy refuses a call without one. The
# signing root is generated on first use and stored encrypted with the same key
# as local secrets, so nothing here needs configuring for the feature to work.
#
# How long a task's certificate stays valid, in seconds (default 3600). It
# bounds the window in which that task may call its tools; a chain of covered
# tasks does not share one window, since each is issued its own when it starts.
# MCP_TOOL_CERT_TTL_SECONDS=3600
#
# Clock-skew tolerance, in seconds, for the proof-of-possession signature that
# accompanies each proxied call (default 60).
# MCP_TOOL_CERT_SIGNATURE_WINDOW_SECONDS=60
#
# Subject/issuer common name of the generated root, and how long it is valid.
# Only read when the root is first generated; changing them later has no effect
# on an existing root.
# MCP_CA_COMMON_NAME=A2Flow MCP Approval CA
# MCP_CA_VALIDITY_DAYS=3650

# ---- MCP registry ----
# Base URL of the official MCP registry used to search for installable servers.
# Defaults to https://registry.modelcontextprotocol.io.
# MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io

# ---- Agent settings ----
# Role description passed to schema_manager.generate_system_prompt().
# The full system prompt is assembled from this plus A2UI workflow rules and schema.
ROLE_DESCRIPTION="You are a helpful assistant. Answer concisely and clearly."
