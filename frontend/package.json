{
  "name": "a2flow-frontend",
  "version": "0.1.2",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "predev": "node scripts/generate-a2ui-catalog.mjs && pnpm generate:api",
    "prebuild": "node scripts/generate-a2ui-catalog.mjs && pnpm generate:api",
    "generate:openapi": "cd ../backend && uv run python -m scripts.export_openapi",
    "generate:api": "pnpm generate:openapi && openapi-ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "ci": "biome ci ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@a2ui/markdown-it": "0.2.2",
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@ag-ui/a2ui-middleware": "^0.0.16",
    "@ag-ui/client": "^1.0.5",
    "@ag-ui/core": "^1.0.5",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hookform/resolvers": "^7.0.7",
    "@lezer/highlight": "^1.2.5",
    "@react-spring/web": "^10.1.2",
    "@reduxjs/toolkit": "^2.15.0",
    "@scalar/nextjs-api-reference": "^0.12.21",
    "@xyflow/react": "^13.0.2",
    "acorn": "^8.19.0",
    "boring-avatars": "^2.0.4",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-redux": "^9.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
