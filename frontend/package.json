{
  "name": "a2flow-frontend",
  "version": "0.1.2",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "predev": "node --use-system-ca scripts/download-a2ui-schema.mjs && pnpm generate:api",
    "prebuild": "node --use-system-ca scripts/download-a2ui-schema.mjs && pnpm generate:api",
    "generate:openapi": "cd ../backend && uv run python -m scripts.export_openapi",
    "generate:api": "pnpm generate:openapi && openapi-ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "ci": "biome ci ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@a2ui/markdown-it": "0.2.2",
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@ag-ui/a2ui-middleware": "^0.0.10",
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hookform/resolvers": "^5.9.2",
    "@lezer/highlight": "^1.2.5",
    "@react-spring/web": "^10.1.2",
    "@reduxjs/toolkit": "^2.13.0",
    "@scalar/nextjs-api-reference": "^0.12.11",
    "@xyflow/react": "^12.12.0",
    "acorn": "^8.19.0",
    "boring-avatars": "^2.0.4",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-redux": "^9.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^20.14.6",
    "msw": "^2.15.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
